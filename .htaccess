RewriteEngine On

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|avif|webp|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:html)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

# Canonical legacy sitelinks captured by Google
RewriteRule ^book-online/?$ /book-repair.html [R=301,L,NC]
RewriteRule ^phone-repairs-park-ridge/?$ /stores/park-ridge.html [R=301,L,NC]
RewriteRule ^computer-parts/?$ /products.html [R=301,L,NC]
RewriteRule ^screen-protector/?$ /shop.html [R=301,L,NC]
RewriteRule ^about-us/?$ /index.html [R=301,L,NC]
RewriteRule ^macbookcharger/?$ /products.html [R=301,L,NC]
RewriteRule ^macbook-charger/?$ /products.html [R=301,L,NC]

# Common legacy store aliases
RewriteRule ^park-ridge/?$ /stores/park-ridge.html [R=301,L,NC]
RewriteRule ^fairfield/?$ /stores/fairfield.html [R=301,L,NC]
RewriteRule ^toowong/?$ /stores/toowong.html [R=301,L,NC]
RewriteRule ^north-lakes/?$ /stores/north-lakes.html [R=301,L,NC]
RewriteRule ^brassall/?$ /stores/brassall.html [R=301,L,NC]

RewriteRule ^store/park-ridge/?$ /stores/park-ridge.html [R=301,L,NC]
RewriteRule ^store/fairfield/?$ /stores/fairfield.html [R=301,L,NC]
RewriteRule ^store/toowong/?$ /stores/toowong.html [R=301,L,NC]
RewriteRule ^store/north-lakes/?$ /stores/north-lakes.html [R=301,L,NC]
RewriteRule ^store/brassall/?$ /stores/brassall.html [R=301,L,NC]

RewriteRule ^stores/park-ridge/?$ /stores/park-ridge.html [R=301,L,NC]
RewriteRule ^stores/fairfield/?$ /stores/fairfield.html [R=301,L,NC]
RewriteRule ^stores/toowong/?$ /stores/toowong.html [R=301,L,NC]
RewriteRule ^stores/north-lakes/?$ /stores/north-lakes.html [R=301,L,NC]
RewriteRule ^stores/brassall/?$ /stores/brassall.html [R=301,L,NC]
